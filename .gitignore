node_modules/
dist/
build/
.output/
coverage/
*.log
# TS 增量编译缓存：不同机器/不同 Node 版本下会互相污染，
# 而且它记录的产物是被忽略的 dist/ —— 入库会导致「干净检出时 tsc 认为无需 emit」
*.tsbuildinfo
.env
.env.local
.env.*.local

# PGlite 本地数据文件（零安装开发库，不入库）
.data/
apps/server/.data/

# 清理演示数据前的自动备份（本地保留，不入库）
apps/server/backups/

# AI 评测：编译产物与评测报告（都是本地产物）
apps/server/.eval-build/
apps/server/.eval/

# 本机工具与诊断产物：内网穿透客户端（50MB+ 二进制）、隧道日志、连通性测试输出
tools/

# 微信开发者工具
apps/miniapp/dist/
apps/miniapp/node_modules/
project.private.config.json

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
.DS_Store

# 上传的图片（演示资源可保留占位）
apps/server/uploads/*
!apps/server/uploads/.gitkeep
