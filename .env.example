# ===== 运行环境 =====
NODE_ENV=development
PORT=3100
API_PREFIX=/api

# ===== 数据库 =====
# 本地零安装开发：使用 PGlite（WASM Postgres，内置 pgvector），无需装 Docker/PostgreSQL
DB_DRIVER=pglite
PGLITE_DATA_DIR=.data/pg

# 生产 / 团队协作：切到真实 PostgreSQL（见 docker-compose.yml）
# DB_DRIVER=postgres
DATABASE_URL=postgres://campus:campus@localhost:5432/campus_mall

# ===== Redis（可选，用于会话缓存/限流）=====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d

# ===== 大模型（任意 OpenAI 兼容接口）=====
# 留空则自动降级为 MockProvider（规则 + 协同过滤），保证无 Key 也能演示
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_VISION_MODEL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=1024
LLM_TIMEOUT_MS=60000

# ===== 微信小程序 =====
WX_APPID=
WX_SECRET=

# ===== 重排服务（RAG 的「召回 → 重排」第二段，Python 微服务）=====
# 留空 = 不重排，召回顺序直出（功能不受影响，只是排序质量差一些）
# 启动：pwsh -File services/rerank/run.ps1
RERANK_BASE_URL=http://127.0.0.1:3200
