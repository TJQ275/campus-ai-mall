{
  "name": "@campus/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "tsx src/db/push.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/push.ts --reset && tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "ai:embed": "tsx src/db/embed.ts",
    "demo:prepare": "tsx src/db/prepare-demo.ts",
    "admin:password": "tsx src/db/admin-password.ts",
    "data:clear-demo": "tsx src/db/clear-demo-data.ts",
    "ai:eval": "tsc -p tsconfig.eval.json && node .eval-build/db/eval.js"
  },
  "dependencies": {
    "@campus/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "@types/express": "^5.0.0"
  },
  "type": "module"
}
