.type-row { display: flex; margin-top: 12rpx; }
.type {
  flex: 1; text-align: center; padding: 20rpx 0; border: 1rpx solid #e5e5e5;
  border-radius: 12rpx; margin-right: 12rpx; font-size: 26rpx;
}
.type-on { border-color: #07c160; color: #07c160; background: #e8fff3; }
.picker { background: #f7f8fa; border-radius: 12rpx; padding: 20rpx; margin-top: 12rpx; font-size: 26rpx; }
.textarea { background: #f7f8fa; border-radius: 12rpx; padding: 20rpx; margin-top: 12rpx; width: 100%; height: 160rpx; font-size: 26rpx; box-sizing: border-box; }
.rule { color: #646566; font-size: 24rpx; line-height: 1.7; margin-top: 12rpx; }
