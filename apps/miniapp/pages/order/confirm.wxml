<view>
  <view class="card" bindtap="goAddress">
    <view wx:if="{{address}}">
      <view class="between">
        <text>{{address.receiver}} {{address.phone}}</text>
        <text class="muted">切换</text>
      </view>
      <view class="muted">{{address.campus}} {{address.detail}}</view>
    </view>
    <view wx:else class="muted">还没有收货地址，点击添加 →</view>
  </view>

  <view class="card">
    <view class="product-card" wx:for="{{items}}" wx:key="cartId">
      <image wx:if="{{!item.coverFailed}}" class="product-cover" src="{{item.cover}}" mode="aspectFill" lazy-load
             data-path="items[{{index}}].coverFailed" binderror="onImageError" />
      <view wx:else class="product-cover cover-fallback">暂无图</view>
      <view class="product-info">
        <view class="product-title">{{item.title}}</view>
        <view class="between">
          <text class="price">{{item.priceText}}</text>
          <text class="muted">× {{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="muted">支付方式（校园项目为模拟支付）</view>
    <view class="channel-row">
      <view class="channel {{channel === 'balance' ? 'channel-on' : ''}}" data-channel="balance" bindtap="pickChannel">余额 {{balanceText}}</view>
      <view class="channel {{channel === 'wechat' ? 'channel-on' : ''}}" data-channel="wechat" bindtap="pickChannel">微信</view>
      <view class="channel {{channel === 'alipay' ? 'channel-on' : ''}}" data-channel="alipay" bindtap="pickChannel">支付宝</view>
    </view>
    <view class="muted mt-16">备注</view>
    <input class="remark" value="{{remark}}" placeholder="选填，例如放自提柜" bindinput="onRemark" />
  </view>

  <view class="card">
    <view class="between"><text>商品金额</text><text>{{totalText}}</text></view>
    <view class="between"><text>配送费</text><text>{{freightText}}</text></view>
    <view class="between"><text>应付</text><text class="price">{{payText}}</text></view>
  </view>

  <view class="h-140"></view>
  <view class="bottom-bar">
    <view>应付 <text class="price">{{payText}}</text></view>
    <button class="btn-primary pay-btn" disabled="{{submitting}}" bindtap="submit">提交订单</button>
  </view>
</view>