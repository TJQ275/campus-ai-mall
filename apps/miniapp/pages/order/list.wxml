<view>
  <view class="tabs">
    <view class="tab {{status === item.key ? 'tab-on' : ''}}" wx:for="{{tabs}}" wx:key="key"
          data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <view class="card" wx:for="{{orders}}" wx:key="id">
    <view class="between" bindtap="goDetail" data-id="{{item.id}}">
      <text class="muted">{{item.orderNo}}</text>
      <text class="status">{{item.statusText}}</text>
    </view>
    <view class="product-card" wx:for="{{item.items}}" wx:for-item="goods" wx:key="id">
      <image class="product-cover" src="{{goods.coverSnapshot}}" mode="aspectFill" />
      <view class="product-info">
        <view class="product-title">{{goods.titleSnapshot}}</view>
        <view class="between">
          <text class="price">{{goods.priceText}}</text>
          <text class="muted">× {{goods.quantity}}</text>
        </view>
        <view wx:if="{{item.status === 'finished' && goods.refundStatus === 'none'}}"
              class="link" data-orderid="{{item.id}}" data-itemid="{{goods.id}}" catchtap="applyAfterSale">申请售后</view>
      </view>
    </view>
    <view class="between footer">
      <text>合计 <text class="price">{{item.payText}}</text></text>
      <view class="actions">
        <view class="act" wx:if="{{item.status === 'pending_pay'}}" data-id="{{item.id}}" bindtap="cancel">取消</view>
        <view class="act primary" wx:if="{{item.status === 'pending_pay'}}" data-id="{{item.id}}" bindtap="pay">去支付</view>
        <view class="act primary" wx:if="{{item.status === 'shipped'}}" data-id="{{item.id}}" bindtap="confirm">确认收货</view>
        <view class="act" data-id="{{item.id}}" bindtap="goDetail">详情</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!orders.length}}">还没有相关订单</view>
</view>
