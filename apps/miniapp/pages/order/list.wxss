.tabs { display: flex; background: #fff; padding: 0 12rpx; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #646566; }
.tab-on { color: #07c160; font-weight: 700; border-bottom: 4rpx solid #07c160; }
.status { color: #ee0a24; font-size: 26rpx; }
.footer { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f2f3f5; }
.actions { display: flex; }
.act {
  border: 1rpx solid #ddd; border-radius: 999rpx; padding: 8rpx 24rpx;
  font-size: 24rpx; margin-left: 12rpx; color: #646566;
}
.act.primary { border-color: #07c160; color: #07c160; }
.link { color: #07c160; font-size: 24rpx; margin-top: 8rpx; }
/* 列表尾部的「加载中 / 没有更多了」，比 .empty 轻一些 */
.list-end { text-align: center; color: #969799; font-size: 24rpx; padding: 24rpx 0; }
