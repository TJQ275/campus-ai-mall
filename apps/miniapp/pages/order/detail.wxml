<view wx:if="{{order}}">
  <view class="card status-card">
    <view class="status-text">{{order.statusText}}</view>
    <view class="muted">订单号 {{order.orderNo}}</view>
    <view class="muted" wx:if="{{order.source === 'ai'}}">本单由 AI 助手促成</view>
  </view>

  <view class="card">
    <view class="product-card" wx:for="{{order.items}}" wx:key="id">
      <image class="product-cover" src="{{item.coverSnapshot}}" mode="aspectFill" />
      <view class="product-info">
        <view class="product-title">{{item.titleSnapshot}}</view>
        <view class="between">
          <text class="price">{{item.priceText}}</text>
          <text class="muted">× {{item.quantity}}</text>
        </view>
        <view wx:if="{{order.status === 'finished' && item.refundStatus === 'none'}}"
              class="link" data-itemid="{{item.id}}" bindtap="applyAfterSale">申请售后</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="between"><text>商品金额</text><text>{{order.payText}}</text></view>
    <view class="between"><text>配送费</text><text>{{order.freightText}}</text></view>
    <view class="between"><text>支付方式</text><text>{{order.payChannel || '未支付'}}</text></view>
    <view class="between"><text>下单时间</text><text class="muted">{{order.createdAt}}</text></view>
  </view>

  <view class="card" wx:if="{{order.addressSnapshot}}">
    <view class="muted">收货信息</view>
    <view>{{order.addressSnapshot.receiver}} {{order.addressSnapshot.phone}}</view>
    <view class="muted">{{order.addressSnapshot.campus}} {{order.addressSnapshot.detail}}</view>
  </view>

  <view class="card" wx:if="{{order.remark}}">
    <view class="muted">备注</view>
    <view>{{order.remark}}</view>
  </view>

  <view class="actions-row">
    <button class="act" wx:if="{{order.status === 'pending_pay'}}" bindtap="cancel">取消订单</button>
    <button class="btn-primary act" wx:if="{{order.status === 'pending_pay'}}" bindtap="pay">立即支付</button>
    <button class="btn-primary act" wx:if="{{order.status === 'shipped'}}" bindtap="confirm">确认收货</button>
  </view>
</view>
