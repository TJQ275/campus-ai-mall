.topbar { background: #fff; padding: 16rpx 24rpx; }
.search-box {
  background: #f2f3f5; border-radius: 999rpx; padding: 16rpx 24rpx;
  color: #969799; font-size: 26rpx;
}
.kind-switch { display: flex; background: #fff; padding: 0 24rpx 16rpx; }
.kind {
  flex: 1; text-align: center; padding: 16rpx 0; font-size: 28rpx; color: #646566;
  border-radius: 12rpx;
}
.kind-on { background: #e8fff3; color: #07c160; font-weight: 700; }
.cat-bar { white-space: nowrap; background: #fff; padding: 12rpx 12rpx 16rpx; }
.cat-chip {
  display: inline-block; padding: 10rpx 24rpx; margin: 0 8rpx; border-radius: 999rpx;
  background: #f2f3f5; font-size: 24rpx; color: #646566;
}
.cat-on { background: #07c160; color: #fff; }
.sort-bar { display: flex; background: #fff; padding: 8rpx 24rpx 16rpx; }
.sort { margin-right: 32rpx; font-size: 26rpx; color: #646566; }
.sort-on { color: #07c160; font-weight: 700; }
