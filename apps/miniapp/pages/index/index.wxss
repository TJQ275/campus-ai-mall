.banner { height: 300rpx; }
.banner-img { width: 100%; height: 300rpx; }
.banner-text {
  position: absolute; bottom: 20rpx; left: 24rpx;
  color: #fff; font-size: 26rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5);
}
.ai-entry { background: linear-gradient(135deg, #e8fff3, #f0f9ff); }
.ai-title { font-size: 32rpx; font-weight: 700; }
.ai-badge {
  background: #07c160; color: #fff; border-radius: 999rpx;
  padding: 8rpx 24rpx; font-size: 24rpx;
}
.quick-row { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.quick {
  background: #fff; border: 1rpx solid #07c160; color: #07c160;
  border-radius: 999rpx; padding: 8rpx 20rpx; font-size: 24rpx; margin: 8rpx 12rpx 0 0;
}
.cat-grid { display: flex; flex-wrap: wrap; }
.cat-item { width: 20%; padding: 12rpx 0; text-align: center; }
.cat-dot { font-size: 24rpx; color: #323233; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 12rpx; }
.reason { color: #07c160; font-size: 22rpx; margin: 6rpx 0; }
