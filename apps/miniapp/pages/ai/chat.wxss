.page { display: flex; flex-direction: column; height: 100vh; }
.scene-bar { display: flex; background: #fff; padding: 12rpx 16rpx; border-bottom: 1rpx solid #f2f3f5; }
.scene {
  padding: 8rpx 22rpx; margin-right: 12rpx; border-radius: 999rpx;
  background: #f2f3f5; color: #646566; font-size: 24rpx;
}
.scene-on { background: #07c160; color: #fff; }
.chat { flex: 1; padding: 20rpx; box-sizing: border-box; }
.hint { padding: 40rpx 10rpx; }
.hint-title { font-size: 32rpx; font-weight: 700; margin-bottom: 8rpx; }
.hint-text { margin-top: 16rpx; line-height: 1.7; color: #646566; font-size: 26rpx; }
.quick-row { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.quick {
  background: #fff; border: 1rpx solid #07c160; color: #07c160;
  border-radius: 999rpx; padding: 10rpx 22rpx; font-size: 24rpx; margin: 10rpx 12rpx 0 0;
}
.msg { margin-bottom: 24rpx; }
.bubble { padding: 20rpx 24rpx; border-radius: 16rpx; line-height: 1.7; font-size: 28rpx; white-space: pre-wrap; }
.user { background: #07c160; color: #fff; margin-left: 120rpx; }
.assistant { background: #fff; }
.typing { color: #969799; }
.assistant-wrap { margin-right: 60rpx; }
.tools { margin-bottom: 10rpx; }
.tool-chip {
  display: flex; align-items: center; background: #fff7e6; color: #b88230;
  border-radius: 10rpx; padding: 10rpx 18rpx; font-size: 24rpx; margin-bottom: 8rpx;
}
.tool-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #07c160; margin-right: 12rpx; }
.tool-dot.fail { background: #ee0a24; }
.cards { margin-top: 12rpx; }
.chat-card { display: flex; background: #fff; border-radius: 16rpx; padding: 16rpx; margin-bottom: 12rpx; }
.chat-cover { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f2f3f5; }
.chat-info { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; justify-content: space-between; }
.chat-title { font-size: 26rpx; line-height: 1.4; }
.confirm { background: #fff; border: 2rpx dashed #07c160; border-radius: 16rpx; padding: 20rpx; margin-top: 12rpx; }
.confirm-text { font-size: 26rpx; line-height: 1.6; }
.confirm-btns { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.cbtn { padding: 12rpx 32rpx; border-radius: 999rpx; font-size: 26rpx; margin-left: 16rpx; }
.cbtn.ghost { border: 1rpx solid #ddd; color: #646566; }
.cbtn.solid { background: #07c160; color: #fff; }
.confirm-done { margin-top: 12rpx; color: #07c160; font-size: 26rpx; }
.msg-meta { margin-top: 8rpx; }
.input-bar {
  display: flex; align-items: center; background: #fff; padding: 16rpx 20rpx;
  border-top: 1rpx solid #f2f3f5;
}
.chat-input { flex: 1; background: #f7f8fa; border-radius: 999rpx; padding: 18rpx 24rpx; font-size: 28rpx; }
.send-btn { width: 160rpx; height: 72rpx; line-height: 72rpx; font-size: 28rpx; margin-left: 16rpx; }
