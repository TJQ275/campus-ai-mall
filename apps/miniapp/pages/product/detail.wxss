.gallery { height: 600rpx; background: #fff; }
.gallery-img { width: 100%; height: 600rpx; }
.price-row { display: flex; align-items: baseline; }
.big { font-size: 44rpx; }
.strike { text-decoration: line-through; margin-left: 16rpx; }
.title { font-size: 32rpx; font-weight: 700; margin: 12rpx 0 6rpx; }
.tags { margin-top: 12rpx; }
.meta { display: flex; gap: 24rpx; color: #969799; font-size: 24rpx; margin-top: 12rpx; }
.sku-picker { background: #f7f8fa; border-radius: 12rpx; padding: 20rpx; margin-top: 12rpx; font-size: 26rpx; }
.ai-card { background: linear-gradient(135deg, #f0f9ff, #e8fff3); }
.section-title { font-size: 30rpx; font-weight: 700; }
.summary-text { margin: 12rpx 0; line-height: 1.6; font-size: 26rpx; }
.pros { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }
.pros-tag { color: #07c160; font-size: 24rpx; margin: 6rpx 16rpx 0 0; }
.cons-tag { color: #e6a23c; font-size: 24rpx; margin: 6rpx 16rpx 0 0; }
.desc { margin-top: 12rpx; line-height: 1.7; font-size: 26rpx; color: #646566; }
.review { padding: 16rpx 0; border-bottom: 1rpx solid #f2f3f5; }
.bottom-bar {
  position: fixed; left: 0; right: 0; bottom: 0; background: #fff; display: flex;
  align-items: center; padding: 12rpx 20rpx; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06);
}
.bar-icon { font-size: 24rpx; color: #646566; padding: 0 16rpx; }
.bar-icon.ai { color: #07c160; font-weight: 700; }
.bar-btn { flex: 1; margin: 0 8rpx; height: 76rpx; line-height: 76rpx; font-size: 26rpx; }
.buy { background: #ee0a24; }
