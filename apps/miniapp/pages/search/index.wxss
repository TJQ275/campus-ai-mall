.search-bar { display: flex; align-items: center; background: #fff; padding: 16rpx 24rpx; }
.search-input { flex: 1; background: #f2f3f5; border-radius: 999rpx; padding: 16rpx 24rpx; font-size: 26rpx; }
.scan-btn { color: #07c160; font-size: 26rpx; margin-left: 16rpx; }
.go-btn { color: #323233; font-size: 26rpx; margin-left: 16rpx; }
.hot-row { display: flex; flex-wrap: wrap; }
.hot-word { background: #f2f3f5; border-radius: 999rpx; padding: 10rpx 24rpx; margin: 8rpx 12rpx 0 0; font-size: 24rpx; }
.tip { margin-top: 24rpx; color: #969799; font-size: 24rpx; line-height: 1.6; }
