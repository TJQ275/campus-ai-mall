{
  "name": "campus-ai-mall",
  "private": true,
  "version": "0.1.0",
  "description": "AI优选零食：校园零食 + 二手教材商城，AI 助手为核心（原生微信小程序 / NestJS / Vue3 管理后台）",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "pnpm --filter @campus/shared build",
    "dev:server": "pnpm --filter @campus/server dev",
    "db:generate": "pnpm --filter @campus/server db:generate",
    "db:push": "pnpm --filter @campus/server db:push",
    "db:seed": "pnpm --filter @campus/server db:seed",
    "db:studio": "pnpm --filter @campus/server db:studio",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "ai:embed": "pnpm --filter @campus/server ai:embed",
    "dev:admin": "pnpm --filter @campus/admin dev",
    "build:admin": "pnpm --filter @campus/admin build",
    "test:miniapp": "node tests/miniapp-wxml.test.cjs && node tests/miniapp-auth.test.cjs && node tests/miniapp-sse.test.cjs && node tests/miniapp-api.test.cjs",
    "dev:miniapp": "echo 用微信开发者工具打开 apps/miniapp 目录",
    "db:reset": "pnpm --filter @campus/server db:reset",
    "test:acceptance": "node tests/acceptance.test.cjs",
    "test:hardening": "node tests/api-hardening.test.cjs",
    "test:unit": "pnpm --filter @campus/server test:unit",
    "test": "pnpm test:unit && pnpm test:acceptance && pnpm test:hardening && pnpm test:miniapp",
    "demo:prepare": "pnpm --filter @campus/server demo:prepare",
    "setup": "pnpm db:push && pnpm db:seed && pnpm demo:prepare",
    "dev": "pwsh -File scripts/dev.ps1",
    "ai:eval": "pnpm --filter @campus/server ai:eval",
    "ci": "pwsh -File scripts/ci.ps1",
    "rerank": "pwsh -File services/rerank/run.ps1",
    "test:py": "cd services/rerank && python -m pytest -q"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TJQ275/campus-ai-mall.git"
  },
  "homepage": "https://github.com/TJQ275/campus-ai-mall#readme",
  "license": "MIT"
}
